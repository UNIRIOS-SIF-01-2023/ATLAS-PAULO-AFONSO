# Copie para .env e preencha. O .env não vai para o GitHub.
# Banco local: MariaDB na porta 3320 (bash scripts/db.sh start).
DB_HOST=127.0.0.1
DB_PORT=3320
DB_USER=atlas
DB_PASSWORD=
DB_NAME=ATLAS
DB_NAME_STAGE=ATLAS_STAGE
# Opcional: caminho do certificado CA para banco remoto com TLS.
DB_SSL_CA=
# Segredo do login (JWT). Gere um valor longo e aleatório.
JWT_SECRET=
